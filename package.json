{
  "name": "critique-hud",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Critique HUD — A shared cognitive mirror for Design Thinking critiques",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:e2e": "playwright test",
    "setup": "prisma generate && prisma db push && echo 'Setup complete'"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "next": "^15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.15.0": true,
    "prisma@6.15.0": true,
    "@prisma/engines@6.15.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
